/* Layout compacto. Nada depende da largura de uma captura de tela. */
Screen { background: #101016; color: #E8E5F0; }
Button { min-width: 8; height: 3; border: none; background: #252336; color: #E8E5F0; }
Button:hover { background: #39314F; }
Button:focus { text-style: bold; outline: tall #A78BFA; }
Button.-primary { background: #A78BFA; color: #15101F; }
Input { height: 3; border: tall #383347; background: #1B1B27; color: #E8E5F0; }
Input:focus { border: tall #A78BFA; }
Select { height: 3; }
SelectCurrent { border: tall #383347; background: #1B1B27; }
SelectOverlay { background: #1B1B27; }
#top { height: 3; padding: 0 1; border-bottom: solid #302B40; }
#brand { width: 21; height: 2; padding-top: 1; color: #A78BFA; text-style: bold; }
#model-label { width: 1fr; height: 2; padding-top: 1; color: #AAA3BA; text-overflow: ellipsis; }
#mode { width: 10; margin-left: 1; }
#settings { width: 5; min-width: 5; margin-left: 1; }
#body { height: 1fr; }
#sidebar { width: 27; padding: 1; border-right: solid #302B40; }
#new { width: 100%; margin-bottom: 1; }
#search { margin-bottom: 1; }
#chats { height: 1fr; background: transparent; }
#chats ListItem { height: 2; padding: 0 1; }
#chats Label { width: 100%; text-overflow: ellipsis; }
#chats > ListItem.-highlight { background: #302744; color: #C4AFFC; }
#chat-actions { height: 3; margin-top: 1; }
#chat-actions Button { width: 1fr; min-width: 1; }
#rename { margin-right: 1; }
#about { width: 100%; margin-top: 1; }
#main { width: 1fr; padding: 0 2 1 2; }
#workspace { height: 2; padding-top: 1; color: #8E879E; text-overflow: ellipsis; }
#messages { height: 1fr; padding: 1 0; scrollbar-size: 1 1; }
.message { height: auto; width: 100%; margin-bottom: 1; padding: 0 1; }
.speaker { height: 1; color: #A78BFA; text-style: bold; }
.message Markdown { height: auto; padding: 0; margin: 0; background: transparent; }
.message MarkdownParagraph { margin: 0 0 1 0; }
.user { border-left: solid #5D5472; }
.user .speaker { color: #AAA3BA; }
.tool { border-left: solid #383347; color: #AAA3BA; max-height: 9; overflow-y: auto; }
.tool .speaker { color: #8E879E; }
#status { height: auto; max-height: 3; min-height: 1; color: #AAA3BA; margin-bottom: 1; }
#composer { height: 3; }
#prompt { width: 1fr; }
#send { width: 10; margin-left: 1; }
Footer { background: #1B1B27; color: #AAA3BA; }
.hide-sidebar #sidebar, .narrow #sidebar { display: none; }
.narrow #main { padding: 0 1 1 1; }
.tiny #brand { width: 13; }
.tiny #settings { display: none; }
.tiny #send { width: 7; min-width: 7; }
.tiny #mode { width: 8; min-width: 8; }
.minimal #workspace, .minimal #settings, .minimal #mode, .minimal Footer { display: none; }
.minimal #top { height: 3; }
.minimal #main { padding-top: 1; }
ModalScreen { align: center middle; background: #000000 65%; }
.dialog { width: 76; max-width: 95%; height: auto; max-height: 90%; padding: 1 2; background: #1B1B27; border: round #A78BFA; }
.dialog-title { height: 2; color: #A78BFA; text-style: bold; }
.dialog-body { height: auto; max-height: 65vh; padding: 0 1 0 0; }
.dialog-body Static { height: auto; }
.dialog-body Label { margin-top: 1; height: auto; }
.dialog-body Markdown { padding: 0; }
.dialog-actions { height: 3; align-horizontal: right; margin-top: 1; }
.dialog-actions Button { margin-left: 1; }
.setup-dialog { height: 90%; }
.setup-dialog .dialog-body { height: 1fr; }
.hint { color: #AAA3BA; margin-top: 1; }
#setup-error { color: #FB7185; height: auto; margin-top: 1; }
.small-dialog { max-height: 16; }
.small-dialog Input { margin: 1 0; }
.light Screen { background: #FAF9FD; color: #252033; }
.light ModalScreen { background: #000000 35%; }
.light #top, .light #sidebar { border: none; }
.light #top { border-bottom: solid #DDD5E9; }
.light #sidebar { border-right: solid #DDD5E9; }
.light #brand, .light .speaker { color: #7C3AED; }
.light Input, .light SelectCurrent { background: #FFFFFF; color: #252033; border: tall #DDD5E9; }
.light Input:focus { border: tall #7C3AED; }
.light Button { background: #F1ECFA; color: #392A54; }
.light Button.-primary { background: #7C3AED; color: #FFFFFF; }
.light #model-label, .light #status, .light #workspace { color: #6F657F; }
.light .dialog { background: #FFFFFF; border: round #7C3AED; color: #252033; }
.light .tool { color: #6F657F; }
.light #chats > ListItem.-highlight { background: #F1ECFA; color: #7C3AED; }
.light Footer { background: #F1ECFA; color: #6F657F; }
